# =============================================================================
# Carryforth — Local Development Environment
# =============================================================================
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# All defaults here work with `docker compose up` out of the box.
#
# Service ports (defaults):
#   Postgres    → localhost:5432
#   Redis       → localhost:6379
#   Typesense   → localhost:8108
#   Adminer     → localhost:8082  (DB browser UI)
#   Keycloak    → localhost:8180  (local OAuth/OIDC)
#   Prometheus  → localhost:9091  (metrics UI)
#
# Prometheus used to bind host port 9090, which commonly conflicts with a
# machine-wide Prometheus or reverse proxy. Override this value if 9091 is also
# occupied; the container continues to listen on 9090 internally.
BUZZ_PROMETHEUS_PORT=9091
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres 17)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://buzz:buzz_dev@localhost:5432/buzz
# Optional read-replica URL; unset/blank keeps all reads on the writer.
# READ_DATABASE_URL=postgres://buzz:buzz_dev@localhost:5433/buzz
# Relay-owned Postgres pools are explicit so semantic traversal cannot consume
# row-zero host binding or all ordinary Project/Meeting capacity.
BUZZ_DB_MAIN_MAX_CONNECTIONS=12
BUZZ_DB_MAIN_MIN_CONNECTIONS=2
BUZZ_DB_MAIN_ACQUIRE_TIMEOUT_SECS=3
BUZZ_DB_MAIN_MAX_LIFETIME_SECS=1800
BUZZ_DB_MAIN_IDLE_TIMEOUT_SECS=600
BUZZ_DB_READ_MAX_CONNECTIONS=8
BUZZ_DB_READ_MIN_CONNECTIONS=1
BUZZ_DB_READ_ACQUIRE_TIMEOUT_SECS=3
BUZZ_DB_READ_MAX_LIFETIME_SECS=1800
BUZZ_DB_READ_IDLE_TIMEOUT_SECS=600
BUZZ_DB_CONTROL_MAX_CONNECTIONS=2
BUZZ_DB_CONTROL_MIN_CONNECTIONS=1
BUZZ_DB_CONTROL_ACQUIRE_TIMEOUT_SECS=1
BUZZ_DB_CONTROL_MAX_LIFETIME_SECS=1800
BUZZ_DB_CONTROL_IDLE_TIMEOUT_SECS=600
BUZZ_DB_AUDIT_MAX_CONNECTIONS=2
BUZZ_DB_AUDIT_MIN_CONNECTIONS=1
BUZZ_DB_AUDIT_ACQUIRE_TIMEOUT_SECS=3
BUZZ_DB_AUDIT_MAX_LIFETIME_SECS=1800
BUZZ_DB_AUDIT_IDLE_TIMEOUT_SECS=600
BUZZ_DB_SEARCH_MAX_CONNECTIONS=2
BUZZ_DB_SEARCH_MIN_CONNECTIONS=1
BUZZ_DB_SEARCH_ACQUIRE_TIMEOUT_SECS=3
BUZZ_DB_SEARCH_MAX_LIFETIME_SECS=1800
BUZZ_DB_SEARCH_IDLE_TIMEOUT_SECS=600
BUZZ_DB_ORDINARY_MAIN_RESERVE=4
BUZZ_DB_SERVER_CONNECTION_RESERVE=4
PGHOST=localhost
PGPORT=5432
PGUSER=buzz
PGPASSWORD=buzz_dev
PGDATABASE=buzz

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Max connections in the relay's shared Redis pool (default 16).
# BUZZ_REDIS_POOL_SIZE=16

# -----------------------------------------------------------------------------
# Typesense (search)
# -----------------------------------------------------------------------------
TYPESENSE_API_KEY=buzz_dev_key
TYPESENSE_URL=http://localhost:8108

# -----------------------------------------------------------------------------
# Relay (WebSocket server)
# -----------------------------------------------------------------------------
# Bind address for the relay (host:port)
BUZZ_BIND_ADDR=0.0.0.0:3000
# Public WebSocket URL — used in NIP-42 auth challenges
RELAY_URL=ws://localhost:3000
# Stable relay signing key. Set this in dev if you want REST-created forum posts
# to keep resolving to the original author across relay restarts.
# BUZZ_RELAY_PRIVATE_KEY=<32-byte hex private key>

# -----------------------------------------------------------------------------
# Trusted managed-runtime supervision (Role Continuity stage 7)
# -----------------------------------------------------------------------------
# Automatic ended(unrecoverable) is guarded twice: an operator must opt in the
# exact Assignment's recovery policy, and this deployment kill switch must also
# be true. Keep it false until a trusted external supervisor is registered.
# Enabling it requires BUZZ_AUDIT_ENABLED=true and a stable relay key above.
# BUZZ_RUNTIME_UNRECOVERABLE=false
# BUZZ_RUNTIME_SUPERVISION_INTERVAL_SECS=5
# BUZZ_RUNTIME_SUPERVISION_BATCH_LIMIT=25
# BUZZ_RUNTIME_SUPERVISION_CLAIM_SECS=60

# Optional trusted identity used by the managed ACP Supervisor Adapter. The
# Relay operator must register this public key against each managed-Agent
# Assignment before enabling supervision. It must be distinct from the Agent
# key and is consumed by the ACP harness; model-facing Agent children receive
# only BUZZ_RUNTIME_ID / BUZZ_RUNTIME_EPOCH.
# BUZZ_RUNTIME_SUPERVISOR_PRIVATE_KEY=nsec1...
# Desktop derives a pair-scoped state path automatically. A direct ACP/deployment
# integration must also provide an absolute durable path.
# BUZZ_RUNTIME_SUPERVISION_STATE_PATH=/var/lib/buzz/runtime-supervision/member-relay.json
#
# The trusted ACP harness consumes the supervisor key before Tokio starts.
# Do not provision the following values directly: the harness injects the
# server-issued command fence into model-facing Agent processes.
# BUZZ_RUNTIME_ID=<server-issued runtime UUID>
# BUZZ_RUNTIME_EPOCH=<positive server-issued epoch>
# Optional: path to the web UI dist directory. When set, the relay serves
# the web frontend at / for browser requests. Leave unset for local dev
# (use `just web` for Vite HMR instead).
# BUZZ_WEB_DIR=./web/dist

# Meeting V1 rollout gate. Defaults to false and only controls creation of new
# v=2 + moderated-baton-v1 sessions; existing V1 sessions remain serviceable.
# BUZZ_MEETING_V1_CREATE_ENABLED=false
# Meeting V2 backend rollout gate. Defaults to false and only controls creation
# of new v=3 + moderated-board-v1 sessions; existing V2 sessions retain their
# Board/Floor lifecycle and can still be ended after this gate is closed.
# BUZZ_MEETING_V2_CREATE_ENABLED=false
# Meeting V2 action-finalization rollout gate. Defaults to false, is additive
# to BUZZ_MEETING_V2_CREATE_ENABLED, and only controls creation of new
# v=3 + moderated-board-actions-v2 sessions. Existing direct-action sessions
# retain their runtime, recovery, and End paths.
# BUZZ_MEETING_V2_DIRECT_ACTIONS_CREATE_ENABLED=false
# Deployment master switch. This alone never widens access: each Community
# also requires the durable buzz-admin audit/approve/enable workflow. Once a
# Community publishes the contract, every serving Relay must keep this true.
# BUZZ_MEETING_COMMUNITY_READ_ENABLED=false
# Timing/capacity values are copied into each new V1 Session and never change
# that Session afterward. The defaults are the production protocol profile.
# BUZZ_MEETING_V1_AGENT_OFFER_ACK_MS=5000
# BUZZ_MEETING_V1_HUMAN_OFFER_ACK_MS=15000
# BUZZ_MEETING_V1_MODERATOR_DECISION_MS=180000
# BUZZ_MEETING_V1_GRANT_SOFT_LEASE_MS=30000
# BUZZ_MEETING_V1_PROGRESS_INTERVAL_MS=10000
# BUZZ_MEETING_V1_GRANT_HARD_DEADLINE_MS=300000
# BUZZ_MEETING_V1_AGENT_SAFETY_MARGIN_MS=30000
# BUZZ_MEETING_V1_MAX_HANDOFF_DEPTH=5
# BUZZ_MEETING_V1_MAX_OPEN_HANDOFFS=32
# Meeting V2 freezes its Board budget independently from its Baton/Floor
# profile. Values below are copied into each new V2 Session and never change
# that Session afterward.
# BUZZ_MEETING_V2_BOARD_MAINTENANCE_MS=180000
# BUZZ_MEETING_V2_AGENT_OFFER_ACK_MS=5000
# BUZZ_MEETING_V2_HUMAN_OFFER_ACK_MS=15000
# BUZZ_MEETING_V2_MODERATOR_DECISION_MS=180000
# BUZZ_MEETING_V2_GRANT_SOFT_LEASE_MS=30000
# BUZZ_MEETING_V2_PROGRESS_INTERVAL_MS=10000
# BUZZ_MEETING_V2_GRANT_HARD_DEADLINE_MS=300000
# BUZZ_MEETING_V2_AGENT_SAFETY_MARGIN_MS=30000
# BUZZ_MEETING_V2_MAX_HANDOFF_DEPTH=5
# BUZZ_MEETING_V2_MAX_OPEN_HANDOFFS=32
# BUZZ_MEETING_V2_MODERATOR_MAX_REJUDGMENTS=2
# BUZZ_MEETING_V2_MODERATOR_MAX_CAS_REBASES_PER_ATTEMPT=8
# Runtime worker tuning; these do not alter a Session's protocol semantics.
# BUZZ_MEETING_REVOCATION_LEASE_MS=30000
# BUZZ_MEETING_REVOCATION_SESSION_BATCH=32

# Project Context semantic foundation. Supported local source launchers default
# the two process switches below to true and request all missing Provider values.
# API-key input is hidden; Base URL and Request Model have no defaults and use
# ordinary input. Values are persisted only to the Git-ignored .env with mode
# 0600. The launchers also generate a stable local Relay signer when needed.
# Raw Relay invocations remain fail-closed unless explicitly configured.
#
# The process switch and each Community's durable semantic_index_enabled gate
# must both be enabled before title/summary leaves Carryforth. The first
# generation sends overview metadata only; Document body and future chunks are
# not authorized by these settings. Startup never changes the durable Community
# index/query gates or acknowledges problem egress on the operator's behalf.
# BUZZ_SEMANTIC_WORKER_ENABLED=false
# BUZZ_SEMANTIC_API_KEY=
# BUZZ_SEMANTIC_BASE_URL=
# BUZZ_SEMANTIC_REQUEST_MODEL=
# BUZZ_SEMANTIC_REQUEST_TIMEOUT_SECS=30
# BUZZ_SEMANTIC_REQUEST_INTERVAL_MS=1000
# BUZZ_SEMANTIC_CLAIM_SECS=60
# BUZZ_SEMANTIC_MAX_ATTEMPTS=8
# Deployment master only; each Community query gate remains independently off.
# BUZZ_SEMANTIC_GRAPH_QUERY_HTTP_AVAILABLE=false
# Whole-process admission remains broader than the database-only Stage C gate.
BUZZ_SEMANTIC_GRAPH_QUERY_MAX_IN_FLIGHT=8
# Provisional safe local default. Requalify 1 -> 2 -> 4 -> 8 before raising it;
# saturation returns retryable traversal_busy without opening a DB transaction.
BUZZ_SEMANTIC_GRAPH_TRAVERSAL_MAX_IN_FLIGHT=2
# Local development trusts the one Relay started from this checkout. This does
# not enable Provider egress and is not suitable for multiple Relays, a load
# balancer, or production. Those topologies must use attested-fleet.
BUZZ_SEMANTIC_GRAPH_QUERY_FLEET_POLICY=trusted-single-relay
# Required only for attested-fleet when the HTTP deployment master is true. The
# deployment control plane must give every routable Relay the same deployment
# ID and a unique, stable instance ID matching the short-lived buzz-admin fleet
# inventory.
# BUZZ_SEMANTIC_GRAPH_QUERY_DEPLOYMENT_ID=
# BUZZ_SEMANTIC_GRAPH_QUERY_INSTANCE_ID=

# Shared Redis-backed admission limits. Defaults shown below; each value must
# be a positive integer.
# BUZZ_RATE_LIMIT_HUMAN_MESSAGES_PER_MIN=60
# BUZZ_RATE_LIMIT_HUMAN_API_CALLS_PER_MIN=300
# BUZZ_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC=10
# BUZZ_RATE_LIMIT_AGENT_STANDARD_MESSAGES_PER_MIN=120
# BUZZ_RATE_LIMIT_AGENT_STANDARD_API_CALLS_PER_MIN=600
# BUZZ_RATE_LIMIT_AGENT_ELEVATED_MESSAGES_PER_MIN=300
# BUZZ_RATE_LIMIT_AGENT_PLATFORM_MESSAGES_PER_MIN=600

# -----------------------------------------------------------------------------
# Git (NIP-34 bare repositories)
# -----------------------------------------------------------------------------
# Root directory for ephemeral Git workspaces and the disposable pack cache.
# Default: ./repos (relative to CWD).
# BUZZ_GIT_REPO_PATH=./repos
# BUZZ_GIT_MAX_PACK_BYTES=524288000
# BUZZ_GIT_MAX_REPO_BYTES=1048576000
# Process-local immutable pack/index cache. Zero disables retention.
# BUZZ_GIT_PACK_CACHE_PATH=./repos/.pack-cache
# BUZZ_GIT_PACK_CACHE_MAX_BYTES=5368709120
# BUZZ_GIT_PACK_CACHE_MAX_CONCURRENT_POPULATIONS=2

# -----------------------------------------------------------------------------
# Media Upload Admission
# -----------------------------------------------------------------------------
# Bound image/video parser and storage work admitted by one relay process.
# BUZZ_MEDIA_MAX_CONCURRENT_UPLOADS=8
# BUZZ_MEDIA_MAX_CONCURRENT_UPLOADS_PER_PUBKEY=2
# BUZZ_MEDIA_UPLOADS_PER_MINUTE=30
# Require Blossom t=get auth and relay membership for GET/HEAD /media/*.
# Keep off until Desktop and CLI clients that attach media read auth are deployed.
# BUZZ_REQUIRE_MEDIA_GET_AUTH=false
# Legacy alias accepted by the relay while rollout docs catch up:
# BUZZ_REQUIRE_MEDIA_READ_AUTH=false

# -----------------------------------------------------------------------------
# Ephemeral Channels (TTL testing)
# -----------------------------------------------------------------------------
# Override the TTL for all ephemeral channels (in seconds). When set, any
# channel created with a TTL tag will use this value instead of the
# client-provided one. Unset to use the client-provided TTL.
# BUZZ_EPHEMERAL_TTL_OVERRIDE=60

# How often the reaper checks for expired ephemeral channels (default: 60s).
# BUZZ_REAPER_INTERVAL_SECS=5

# -----------------------------------------------------------------------------
# Logging / Tracing
# -----------------------------------------------------------------------------
RUST_LOG=buzz_relay=debug,buzz_db=debug,buzz_auth=debug,buzz_pubsub=debug,tower_http=debug

# OTLP tracing endpoint (optional — leave unset to disable)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# ACP (Agent Communication Protocol — buzz-acp harness)
# -----------------------------------------------------------------------------
# The ACP harness bridges Carryforth events to AI agents. Each env var below maps
# to a CLI flag of the same name (lowercase, hyphens → underscores). All values
# are optional unless noted; defaults are shown in comments.
#
# Quick start:
#   BUZZ_PRIVATE_KEY=<hex>  BUZZ_RELAY_URL=ws://localhost:3000  buzz-acp

# ── Identity & auth ──────────────────────────────────────────────────────────
# Nostr private key (hex or bech32). REQUIRED — identifies the agent on the relay.
# BUZZ_PRIVATE_KEY=<32-byte hex or nsec1… private key>

# Relay WebSocket URL the harness connects to.
# Note: the relay itself uses RELAY_URL (above); this is the ACP harness's
# connection target — they happen to point at the same place in local dev.
# BUZZ_RELAY_URL=ws://localhost:3000

# ── Agent subprocess ─────────────────────────────────────────────────────────
# Binary to spawn as the AI agent (e.g. "goose", "codex-acp", "claude-code").
# BUZZ_ACP_AGENT_COMMAND=goose

# Comma-separated arguments passed to the agent binary.
# Goose default: "acp". Codex/Claude default: "" (empty).
# BUZZ_ACP_AGENT_ARGS=acp

# Binary for an optional MCP server sidecar (e.g. buzz-dev-mcp for buzz-agent).
# BUZZ_ACP_MCP_COMMAND=

# Number of parallel agent subprocesses (1–32).
# BUZZ_ACP_AGENTS=1

# Meeting V1 ordinary-Agent Offer policy. When true (default), the Harness
# deterministically reserves local capacity and ACKs without invoking the LLM.
# BUZZ_ACP_MEETING_V1_AUTO_ACCEPT=true

# Optional durable Meeting V1 participant ledger path. The default is the
# platform state directory, keyed by Agent pubkey.
# BUZZ_ACP_MEETING_V1_LEDGER_PATH=

# Desired LLM model ID. Applied to every new ACP session.
# Use `buzz-acp models` to discover available model IDs.
# BUZZ_ACP_MODEL=

# ── Timeouts & sessions ──────────────────────────────────────────────────────
# Max seconds per agent turn before timeout (default 320 = ~5 min).
# BUZZ_ACP_TURN_TIMEOUT=320

# Max turns per session before proactive rotation. 0 = disabled (rotate only
# on MaxTokens / MaxTurnRequests). Recommended: 50 for long-running agents.
# BUZZ_ACP_MAX_TURNS_PER_SESSION=0

# ── Prompts ──────────────────────────────────────────────────────────────────
# System prompt injected into every agent session (inline text).
# BUZZ_ACP_SYSTEM_PROMPT=

# Path to a file containing the system prompt (mutually exclusive with above).
# BUZZ_ACP_SYSTEM_PROMPT_FILE=

# Message sent to the agent immediately after session creation.
# BUZZ_ACP_INITIAL_MESSAGE=

# ── Heartbeat ────────────────────────────────────────────────────────────────
# Seconds between heartbeat prompts. 0 = disabled. Must be 0 or ≥10.
# Recommended: 60 for long-running agents to prevent idle session timeouts.
# BUZZ_ACP_HEARTBEAT_INTERVAL=0

# Heartbeat prompt text (inline). Mutually exclusive with file variant.
# BUZZ_ACP_HEARTBEAT_PROMPT=

# Path to a file containing the heartbeat prompt.
# BUZZ_ACP_HEARTBEAT_PROMPT_FILE=

# ── Desktop development ──────────────────────────────────────────────────────
# DEV-only: replay first-run onboarding and the Welcome Team kickoff on each
# app launch while keeping the current identity and relay data.
# VITE_BUZZ_FORCE_FRESH_ONBOARDING=true

# ── Subscription & filtering ─────────────────────────────────────────────────
# Subscribe mode: "mentions" (default), "all", or "config" (rule-based).
# BUZZ_ACP_SUBSCRIBE=mentions

# Comma-separated event kind numbers to subscribe to (overrides mode defaults).
# BUZZ_ACP_KINDS=

# Comma-separated channel UUIDs to limit subscription scope.
# BUZZ_ACP_CHANNELS=

# Set to true to disable the @-mention filter in mentions mode.
# BUZZ_ACP_NO_MENTION_FILTER=false

# Path to TOML config file for rule-based subscriptions (config mode).
# BUZZ_ACP_CONFIG=./buzz-acp.toml

# ── Dedup & self-ignore ──────────────────────────────────────────────────────
# How to handle duplicate events: "queue" (default) or "drop".
# BUZZ_ACP_DEDUP=queue

# Set to true to process the agent's own messages (default: ignore self).
# BUZZ_ACP_NO_IGNORE_SELF=false

# ── Context ──────────────────────────────────────────────────────────────────
# Max context messages fetched for thread replies and DMs (0–100). 0 = disabled.
# BUZZ_ACP_CONTEXT_MESSAGE_LIMIT=12

# ── Presence & typing ────────────────────────────────────────────────────────
# Set to true to disable automatic online/offline presence status.
# BUZZ_ACP_NO_PRESENCE=false

# Set to true to disable typing indicators while the agent is processing.
# BUZZ_ACP_NO_TYPING=false

# ── Advanced tuning ──────────────────────────────────────────────────────────
# Event channel buffer capacity (WebSocket → harness). Increase for
# high-throughput agents. Minimum 1.
# BUZZ_ACP_EVENT_BUFFER=256

# ── Legacy aliases ───────────────────────────────────────────────────────────
# These are accepted for backward compatibility but the canonical names above
# are preferred:
#   BUZZ_ACP_PRIVATE_KEY  → BUZZ_PRIVATE_KEY

# Optional relay join policy. Markdown is served by the relay so every join
# surface can present the same documents. Each document and the independent age
# attestation are optional; configuring any one enables policy acceptance.
# BUZZ_TERMS_OF_SERVICE_MARKDOWN="# Terms of Service\n\nFull terms here."
# BUZZ_PRIVACY_POLICY_MARKDOWN="# Privacy Policy\n\nFull policy here."
# BUZZ_AGE_ATTESTATION_REQUIRED=true
