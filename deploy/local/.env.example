# Generated by ./run.sh init. Do not use this file directly and do not commit
# the generated .env. The Relay image must use an exact Carryforth semver tag
# optionally followed by its release-qualified digest. Only the tag+digest form
# is registry-immutable while retaining downgrade protection. Floating
# latest/main tags, bare digests, and retired Buzz images are rejected.
CARRYFORTH_RELAY_IMAGE=CHANGE_ME_PINNED_CARRYFORTH_RELAY_IMAGE

CARRYFORTH_POSTGRES_PORT=55432
CARRYFORTH_REDIS_PORT=56379
CARRYFORTH_MINIO_PORT=59000
CARRYFORTH_HEALTH_PORT=18080
CARRYFORTH_METRICS_PORT=19102

POSTGRES_DB=carryforth
POSTGRES_USER=carryforth
POSTGRES_PASSWORD=CHANGE_ME_GENERATED
REDIS_PASSWORD=CHANGE_ME_GENERATED
CARRYFORTH_S3_ACCESS_KEY=CHANGE_ME_GENERATED
CARRYFORTH_S3_SECRET_KEY=CHANGE_ME_GENERATED
CARRYFORTH_S3_BUCKET=carryforth-media
CARRYFORTH_RELAY_PRIVATE_KEY=CHANGE_ME_GENERATED
CARRYFORTH_GIT_HOOK_HMAC_SECRET=CHANGE_ME_GENERATED
